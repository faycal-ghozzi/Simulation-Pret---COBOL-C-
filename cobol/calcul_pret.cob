       IDENTIFICATION DIVISION.
       PROGRAM-ID. CALCUL-PRET.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT FICHIER-ENTREE ASSIGN TO "entree.txt"
               ORGANIZATION IS LINE SEQUENTIAL.
           SELECT FICHIER-SORTIE ASSIGN TO "sortie.txt"
               ORGANIZATION IS LINE SEQUENTIAL.
       DATA DIVISION.
       FILE SECTION.
       FD  FICHIER-ENTREE.
       01  ENR-ENTREE.
           05  ENT-MONTANT     PIC 9(7)V99.
           05  ENT-TAUX-ANNUEL PIC 9(2)V99.
           05  ENT-DUREE-MOIS  PIC 9(3).

       FD  FICHIER-SORTIE.
       01  ENR-SORTIE.
           05  SOR-MENSUALITE  PIC 9(7)V99.
           05  SOR-COUT-TOTAL  PIC 9(9)V99.
           05  SOR-INTERETS-TOTAL  PIC 9(9)V99.

       WORKING-STORAGE SECTION.
       01  WS-INDICATEURS.
           05  WS-FIN-FICHIER  PIC X VALUE "N".

       01  WS-VARIABLE-CALCUL.
           05  WS-TAUX-MENSUEL     PIC 9(3)V9(9) COMP-3.
           05  WS-FACTEUR          PIC 9(3)V9(9) COMP-3.
           05  WS-MENSUALITE-CALC  PIC 9(7)V99 COMP-3.
           05  WS-COUT-TOTAL-CALC  PIC 9(9)V99 COMP-3.
           05  WS-INTERETS-CALC    PIC 9(9)V99 COMP-3.
           05  WS-DUREE-NUM        PIC 9(3).

       PROCEDURE DIVISION.

       MAIN.

           OPEN INPUT FICHIER-ENTREE.
           OPEN OUTPUT FICHIER-SORTIE.

           READ FICHIER-ENTREE
               AT END MOVE "O" TO WS-FIN-FICHIER
           END-READ

           IF WS-FIN-FICHIER = "N"
               PERFORM CALCULER-MENSUALITE
               PERFORM ECRIRE-RESULTAT
           END-IF

           CLOSE FICHIER-ENTREE
           CLOSE FICHIER-SORTIE

           STOP RUN.

       CALCULER-MENSUALITE.
           
           COMPUTE WS-TAUX-MENSUEL = ENT-TAUX-ANNUEL / 12 / 100

           MOVE ENT-DUREE-MOIS TO WS-DUREE-NUM

           COMPUTE WS-FACTEUR = (1 + WS-TAUX-MENSUEL) ** WS-DUREE-NUM

           COMPUTE WS-MENSUALITE-CALC ROUNDED = 
               ENT-MONTANT * WS-TAUX-MENSUEL * WS-FACTEUR
               / (WS-FACTEUR - 1)

           COMPUTE WS-COUT-TOTAL-CALC ROUNDED = 
               WS-MENSUALITE-CALC * WS-DUREE-NUM

           COMPUTE WS-INTERETS-CALC ROUNDED =
               WS-COUT-TOTAL-CALC - ENT-MONTANT.

       ECRIRE-RESULTAT.

           MOVE WS-MENSUALITE-CALC TO SOR-MENSUALITE
           MOVE WS-COUT-TOTAL-CALC TO SOR-COUT-TOTAL
           MOVE WS-INTERETS-CALC TO SOR-INTERETS-TOTAL
           WRITE ENR-SORTIE.
           